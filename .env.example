# ─── Database ────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/opencare
# Atlas:   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/opencare?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/opencare

# ─── Admin login (used by `npm run seed`) ────────────────────
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# ─── Platform ────────────────────────────────────────────────
PLATFORM_NAME=openCare
# Your main domain. Clients get <slug>.<this domain> automatically
# (needs a wildcard *.domain pointed at Vercel). Leave empty locally.
PLATFORM_ROOT_DOMAIN=
# Public URL of the admin/platform site (used in lead emails)
SITE_URL=http://localhost:3000

# Default lead contacts — editable later in Admin → Settings
LEAD_WHATSAPP=2348073168427
LEAD_PHONE=08073168427
LEAD_EMAIL=you@example.com

# ─── Email (lead notifications) ──────────────────────────────
# Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=openCare Leads <you@example.com>

# ─── Firebase Storage (image uploads) ────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the full JSON on one line, or save it as firebase-service-account.json in the project root.
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
